prontera,155,196,4	script	Chat Troc Ygg	4_CAT_DOWN,{

	mes "[Chat Troc Ygg]";
	mes "Je peux échanger tes objets contre des Yggdrasil Berry ou des Yggdrasil Seed.";
	next;

	mes "Valeurs :";
	mes "- Ressource commune : 100 points/u";
	mes "- Équipement : 500 points/u";
	mes "- Yggdrasil Seed : 5000 points";
	mes "- Yggdrasil Berry : 10000 points";
	next;

	mes "Entre l'ID de l'objet que tu veux échanger.";
	next;
	input .@item_id;

	if (countitem(.@item_id) <= 0) {
		mes "[Chat Troc Ygg]";
		mes "Tu ne possèdes pas cet objet.";
		close;
	}

	mes "[Chat Troc Ygg]";
	mes "Objet : ^00AAFF" + getitemname(.@item_id) + "^000000";
	mes "Tu en possèdes : " + countitem(.@item_id);
	mes "Combien veux-tu proposer ?";
	next;
	input .@amount;

	if (.@amount <= 0 || .@amount > countitem(.@item_id)) {
		mes "[Chat Troc Ygg]";
		mes "Quantité invalide.";
		close;
	}

	.@type = getiteminfo(.@item_id, ITEMINFO_TYPE);

	// Type 4 = arme, Type 5 = armure/équipement
	if (.@type == 4 || .@type == 5) {
		.@unit_value = 500;
	} else {
		.@unit_value = 100;
	}

	.@total = .@unit_value * .@amount;
	.@berry = .@total / 10000;
	.@seed = .@total / 5000;

	mes "[Chat Troc Ygg]";
	mes "Résumé de l'échange :";
	mes "Objet : ^00AAFF" + getitemname(.@item_id) + "^000000 x" + .@amount;
	mes "Valeur unitaire : " + .@unit_value + " points";
	mes "Total : ^00AAFF" + .@total + " points^000000";
	next;

	mes "Tu peux obtenir :";
	mes "- ^FF0000" + .@berry + " Yggdrasil Berry^000000";
	mes "- ^00AA00" + .@seed + " Yggdrasil Seed^000000";
	next;

	switch(select("Recevoir des Berry:Recevoir des Seed:Annuler")) {

	case 1:
		if (.@berry <= 0) {
			mes "[Chat Troc Ygg]";
			mes "Pas assez de points pour une Berry.";
			close;
		}

		delitem .@item_id,.@amount;
		getitem 607,.@berry;

		mes "[Chat Troc Ygg]";
		mes "Échange terminé.";
		close;

	case 2:
		if (.@seed <= 0) {
			mes "[Chat Troc Ygg]";
			mes "Pas assez de points pour une Seed.";
			close;
		}

		delitem .@item_id,.@amount;
		getitem 608,.@seed;

		mes "[Chat Troc Ygg]";
		mes "Échange terminé.";
		close;

	case 3:
		mes "[Chat Troc Ygg]";
		mes "Échange annulé. Tes objets restent dans ton inventaire.";
		close;
	}
}
