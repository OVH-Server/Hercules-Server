//--- Transporteur Prontera vers place marchande Alberta
prontera,159,160,4	script	Transporteur Prontera	1_F_MERCHANT_02,{

	mes "[Transporteur]";
	mes "Direction Place marchande d'Alberta ?";
	next;

	if (select("Oui, allons-y.:Non merci.") == 2) {
		mes "[Transporteur]";
		mes "Comme tu veux.";
		close;
	}

	mes "[Transporteur]";
	mes "En route !";
	close2;

	warp "alberta",212,51;

	end;
}


