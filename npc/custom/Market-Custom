//--- Bot marchant avec liste aléatoire et respawn lorsque vide
alberta,205,39,4	script	Marchand Louche	MERCHANT,{

	mes "[Marchand Louche]";

	// Si stock vide → on génère un nouveau stock
	if (.stock_count == 0) {
		callsub S_GenerateStock;
		mes "Nouvelle marchandise fraîche...";
	}

	mes "Voilà ce que j'ai :";
	next;

	// Construction du menu
	.@menu$ = "";
	for (.@i = 0; .@i < .stock_count; .@i++) {
		.@menu$ += getitemname(.stock_id[.@i])+" - "+.stock_price[.@i]+"z:";
	}
	.@menu$ += "Quitter";

	.@choice = select(.@menu$) - 1;

	if (.@choice == .stock_count) close;

	// Vérif zeny
	if (Zeny < .stock_price[.@choice]) {
		mes "T'as pas assez d'argent.";
		close;
	}

	// Achat
	set Zeny, Zeny - .stock_price[.@choice];
	getitem .stock_id[.@choice],1;

	mes "Bonne affaire.";

	// Retirer l’item du stock
	for (.@i = .@choice; .@i < .stock_count-1; .@i++) {
		.stock_id[.@i] = .stock_id[.@i+1];
		.stock_price[.@i] = .stock_price[.@i+1];
	}

	.stock_count--;

	close;

// Génération du stock
S_GenerateStock:
	deletearray .stock_id[0], getarraysize(.stock_id);
	deletearray .stock_price[0], getarraysize(.stock_price);

	setarray .@pool[0],
		909,910,911,912,913,914,915,938,942,943;

	.stock_count = rand(3,6); // 3 à 6 items

	for (.@i = 0; .@i < .stock_count; .@i++) {
		.@rand = rand(getarraysize(.@pool));
		.stock_id[.@i] = .@pool[.@rand];
		.stock_price[.@i] = rand(1000,10000);
	}

	return;
}
