//--- Bot marchant avec liste aléatoire et respawn lorsque vide
alberta,205,39,4	marketshop	Marchand Louche	4_M_HUMERCHANT,909:1000:1

alberta,205,39,4	script	Marchand_Louche_Ctrl	-1,{

OnInit:
	callsub S_GenerateStock;
	end;

S_GenerateStock:
	// Vide l'ancien stock (on force un reset large)
	marketshopdelitem "Marchand Louche",909;
	marketshopdelitem "Marchand Louche",910;
	marketshopdelitem "Marchand Louche",911;
	marketshopdelitem "Marchand Louche",912;
	marketshopdelitem "Marchand Louche",913;
	marketshopdelitem "Marchand Louche",914;
	marketshopdelitem "Marchand Louche",915;
	marketshopdelitem "Marchand Louche",938;
	marketshopdelitem "Marchand Louche",942;
	marketshopdelitem "Marchand Louche",943;

	// Pool ressources communes
	setarray .@pool[0],
		909,910,911,912,913,914,915,938,942,943;

	.@count = rand(5,10); // nombre de lignes

	for (.@i = 0; .@i < .@count; .@i++) {
		.@item = .@pool[rand(getarraysize(.@pool))];

		// Prix rond entre 1000 et 10000
		.@price = rand(1,10) * 1000;

		// Quantité entre 1 et 99
		.@amount = rand(1,99);

		marketshopadditem "Marchand Louche",.@item,.@price,.@amount;
	}

	end;
}
