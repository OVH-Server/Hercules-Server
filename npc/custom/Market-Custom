//===Transporteur Prontera vers place marchandes Alberta, Ayothaya et Lighthalzen
prontera,159,160,4	script	Transporteur Prontera	1_F_MERCHANT_02,{

	mes "[Transporteur ]";
	mes "Ou souhaitez-vous aller ?";
	next;

	switch(select(
	"Place marchande d'Alberta:"
	+"Place marchande d'Ayothaya:"
	+"Place marchande de Lighthalzen:"
	+"Annuler")) {

	case 1:
		mes "[Transporteur]";
		mes "Direction la place marchande d'Alberta !";
		close2;
		warp "alberta",212,51;
		end;

	case 2:
		mes "[Transporteur]";
		mes "Direction la place marchande d'Ayothaya !";
		close2;
		warp "ayothaya",161,169;
		end;

	case 3:
		mes "[Transporteur]";
		mes "Direction la place marchande de Lighthalzen !";
		close2;
		warp "lighthalzen",158,54;
		end;

	case 4:
		mes "[Transporteur]";
		mes "Tres bien.";
		close;
	}
}


