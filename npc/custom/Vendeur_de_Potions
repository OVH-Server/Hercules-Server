	end;

OnTimer24000:
	npcwalkto 135,203;
	delwaitingroom;
	waitingroom "POTIONS",0;
	setnpctimer 31000;
	end;

// Retour au centre
OnTimer31000:
	npcwalkto 156,183;
	delwaitingroom;
	waitingroom "POTIONS",0;
	setnpctimer 10000; // relance le tour
	end;
}
