prontera,159,154,4	script	Vendeur Ambulant	4_F_KAFRA1,{
	mes "[Vendeur Ambulant]";
	mes "Red Potions ! Je suis partout !";
	next;

	callshop "Shop_RedPotion",1;
	end;

OnInit:
	set .destX,156;
	set .destY,183;

	set .leftX,156;
	set .rightX,166; // +10 cases

	set .phase,0;     // 0 = déplacement initial, 1 = patrouille
	set .direction,0; // 0 = droite, 1 = gauche

	initnpctimer;
	end;

OnTimer1000:

	// Phase 1 : aller au point d'arrivée
	if (.phase == 0) {
		npcwalkto .destX, .destY;

		// Vérifie s'il est arrivé
		getmapxy(.@map$, .@x, .@y, UNITTYPE_NPC);

		if (.@x == .destX && .@y == .destY) {
			set .phase,1;
		}
		setnpctimer 0;
		end;
	}

	// Phase 2 : aller-retour horizontal
	if (.phase == 1) {
		if (.direction == 0) {
			npcwalkto .rightX, .destY;
			set .direction,1;
		} else {
			npcwalkto .leftX, .destY;
			set .direction,0;
		}
	}

	setnpctimer 3000;
	end;
}

-	shop	Shop_RedPotion	-1,501:50
