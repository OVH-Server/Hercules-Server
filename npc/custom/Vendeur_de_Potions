prontera,159,154,4	script	Jean-Pierre Coffe	4_CAT_CHEF,{
	mes "[Vendeur Ambulant]";
	mes "Bonjour ! Et voila ca bouge tous seul !";
	next;

	callshop "Shop_RedPotion",1;
	end;

OnInit:
	// Point de départ
	set .startX,159;
	set .startY,154;

	// Point d'arrivée
	set .destX,156;
	set .destY,183;

	// Zone de déplacement horizontal
	set .leftX,156;
	set .rightX,166; // +10 cases

	set .phase,0;     // 0 = déplacement initial, 1 = patrouille
	set .direction,0; // 0 = droite, 1 = gauche

	initnpctimer;
	end;

OnTimer8000:
	if (.phase == 0) {
		npcwalkto .destX, .destY;
		set .phase,1;
		setnpctimer 0;
		end;
	}

	if (.phase == 1) {
		if (.direction == 0) {
			npcwalkto .rightX, .destY;
			set .direction,1;
		} else {
			npcwalkto .leftX, .destY;
			set .direction,0;
		}
	}

	setnpctimer 0;
	end;
}

-	shop	Shop_RedPotion	-1,501:10,1000:10,715:10
