	next;

	callshop "Shop_RedPotion",1;
	end;

OnInit:
	initnpctimer;
	waitingroom "POTIONS",0;
	end;

// Aller au centre (point de base)
OnTimer3000:
	npcwalkto 156,183;
	delwaitingroom;
	waitingroom "POTIONS",0;
	setnpctimer 10000;
	end;

// Début du tour
OnTimer10000:
	npcwalkto 176,204;
	delwaitingroom;
	waitingroom "Yellow Gemstone !",0;
	setnpctimer 17000;
	end;

OnTimer17000:
	npcwalkto 155,225;
	delwaitingroom;
