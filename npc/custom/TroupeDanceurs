prontera,159,148,5	script	Maitre Ribs	4_GEFFEN_10,{

	mes "[Maitre Ribs]";
	mes "Voulez-vous que je parte danser sur la place principale ?";
	next;

	if (select("Oui, allez à la place principale.:Non, restez ici.") == 2) {
		mes "[Maitre Ribs]";
		mes "Très bien, je reste ici.";
		close;
	}

	mes "[Maitre Ribs]";
	mes "Place a la troupe !";
	close2;

	// Déplacement du leader
	npcwalkto 156,179,2;

	// Attente du trajet
	sleep 6500;

	// Orientation vers le bas
	setnpcdir getnpcid(0),2;

	// Apparition des deux Nacoruri derrière
	enablenpc "Troupe_Nacoruri_Gauche";
	enablenpc "Troupe_Nacoruri_Droite";

	end;
}

// Leader à la place principale (interaction DANSE)
prontera,156,179,5	duplicate(Maitre Ribs)	Maitre Ribs Place	4_GEFFEN_10,{
	mes "[Maitre Ribs]";
	mes "Le spectacle peut commencer.";
	next;

	if (select("DANSER !:Pas maintenant.") == 2) {
		mes "[Maitre Ribs]";
		mes "Très bien, nous attendrons.";
		close;
	}

	mes "[Maitre Ribs]";
	mes "Musique !";
	close2;

	npctalk "Salsa", "Maitre Ribs Place";
	npctalk "Salsa", "Troupe_Nacoruri_Gauche";
	npctalk "Salsa", "Troupe_Nacoruri_Droite";

	end;
}

