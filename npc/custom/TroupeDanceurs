prontera,159,148,4	script	TroupeLeader	4_GEFFEN_10,{
	mes "Place a la troupe !";
	close;
}

-	script	TroupeDanceCtrl	-1,{

OnInit:
	// Spawn du leader
	monster "prontera",159,148,"Troupe Leader",4_GEFFEN_10,1,"TroupeDanceCtrl::OnLeader";
	end;

OnLeader:
	end;

OnTimer1000:
	end;

OnClock0000:
	end;

OnStartDance:
	// Leader parle
	npctalk "Place a la troupe !", "Troupe Leader";

	// Déplacement du leader jusqu’au point d’invocation
	unitwalk getnpcid(0,"Troupe Leader"),156,147;
	sleep 3000;

	// Invocation des deux danseurs derrière lui
	monster "prontera",156,145,"Danseuse Nacoruri",4_F_NACORURI,1,"TroupeDanceCtrl::OnMob";
	monster "prontera",157,145,"Danseuse Dancer",DANCER_H,1,"TroupeDanceCtrl::OnMob";

	sleep 500;

	// Déplacement en formation vers le nord
	// Leader toujours 2 cases devant
	unitwalk getnpcid(0,"Troupe Leader"),156,179;
	unitwalk getnpcid(0,"Danseuse Nacoruri"),156,177;
	unitwalk getnpcid(0,"Danseuse Dancer"),157,177;

	sleep 8000;

	// Pause 3 secondes
	sleep 3000;

	// Salsa, parce que la subtilité est morte
	npctalk "Salsa", "Troupe Leader";
	npctalk "Salsa", "Danseuse Nacoruri";
	npctalk "Salsa", "Danseuse Dancer";

	end;

OnMob:
	end;
}
