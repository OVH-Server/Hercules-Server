prontera,159,148,4	script	TroupeLeader	4_GEFFEN_10,{

	npctalk "Place a la troupe !";

	// Invocation des danseurs derrière le leader
	monster "prontera",159,146,"Danseuse Nacoruri",4_F_NACORURI,1,"TroupeLeader::OnMob";
	monster "prontera",160,146,"Danseuse Dancer",DANCER_H,1,"TroupeLeader::OnMob";

	sleep 500;

	// Déplacement en formation
	// Leader 2 cases devant
	unitwalk getnpcid(0),156,179;
	unitwalk getmonsterid(0,"Danseuse Nacoruri"),156,177;
	unitwalk getmonsterid(0,"Danseuse Dancer"),157,177;

	sleep 8000;

	sleep 3000;

	npctalk "Salsa";
	mapannounce "prontera","Danseuse Nacoruri : Salsa",bc_map;
	mapannounce "prontera","Danseuse Dancer : Salsa",bc_map;

	end;

OnMob:
	end;
}
