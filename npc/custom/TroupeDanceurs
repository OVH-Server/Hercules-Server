prontera,159,148,4	script	TroupeLeader	4_GEFFEN_10,{

	mes "[Leader de la troupe]";
	mes "Voulez-vous que je parte danser sur la place principale ?";
	next;

	if (select("Oui, allez à la place principale.:Non, restez ici.") == 2) {
		mes "[Leader de la troupe]";
		mes "Très bien, je reste ici.";
		close;
	}

	mes "[Leader de la troupe]";
	mes "Place a la troupe !";
	close2;

	// Déplacement du leader
	npcwalkto 156,179;

	// Attente du trajet
	sleep 5000; // ajuste si besoin

	// Spawn à gauche et à droite du leader
	enablenpc "Troupe_Nacoruri"; // gauche
	enablenpc "Troupe_Dancer";   // droite

	end;
}

