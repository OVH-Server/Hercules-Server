prontera,159,148,4	script	TroupeLeader	4_GEFFEN_10,{

	mes "[Leader de la troupe]";
	mes "Nous sommes prêts à enflammer la place.";
	next;
	switch(select("Allez à la place principale !:Finalement non.")) {

	case 1:
		mes "[Leader de la troupe]";
		mes "Place a la troupe !";
		close;

		npctalk "Place a la troupe !";

		// Spawn des danseurs derrière le leader
		monster "prontera",159,146,"Danseuse Nacoruri",4_F_NACORURI,1;
		monster "prontera",160,146,"Danseuse Dancer",DANCER_H,1;

		sleep 500;

		// Déplacement du leader
		unitwalk getnpcid(0),156,179;

		// Les danseurs suivent (position relative)
		unitwalk getnpcid(0),156,177;
		unitwalk getnpcid(0),157,177;

		sleep 8000;

		sleep 3000;

		npctalk "Salsa";

		end;

	case 2:
		mes "[Leader de la troupe]";
		mes "Une autre fois alors.";
		close;
	}
}
