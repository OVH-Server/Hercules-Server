prontera,164,171,5	script	Maitre Ribs	4_GEFFEN_10,{

	mes "[Maitre Ribs]";
	mes "Voulez-vous que je parte danser sur la place principale ?";
	next;

	if (select("Oui, allez à la place principale.:Non, restez ici.") == 2) {
		mes "[Maitre Ribs]";
		mes "Tres bien, je reste ici.";
		close;
	}

	mes "[Maitre Ribs]";
	mes "Place a la troupe !";
	close2;

	// Déplacement du leader
	npcwalkto 156,188;

	// Attente du trajet
	sleep 6500;

	// Orientation vers le bas (une fois arrivé)
	setnpcdir getnpcid(0),2;

	// Apparition des deux Nacoruri derrière (gauche + droite)
	enablenpc "Troupe_Nacoruri_Gauche";
	enablenpc "Troupe_Nacoruri_Droite";

	end;

OnTimer15000:
	npctalk "SALSA !";
	initnpctimer;
	end;

}

// Derrière gauche du leader 
prontera,155,188,5	script	Troupe_Nacoruri_Gauche	4_F_NACORURI,{
	end;

OnInit:
	disablenpc "Troupe_Nacoruri_Gauche";
	end;
}

// Derrière droite du leader 
prontera,157,188,5	script	Troupe_Nacoruri_Droite	4_F_NACORURI,{
	end;

OnInit:
	disablenpc "Troupe_Nacoruri_Droite";
	end;
}
