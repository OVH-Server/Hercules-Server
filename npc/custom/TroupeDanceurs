prontera,159,148,4	script	TroupeLeader	4_GEFFEN_10,{

	mes "[Leader de la troupe]";
	mes "Nous sommes prêts à rejoindre la place principale.";
	next;

	if (select("Allez à la place principale !:Pas maintenant.") == 2) {
		mes "[Leader de la troupe]";
		mes "Très bien.";
		close;
	}

	mes "[Leader de la troupe]";
	mes "Place a la troupe !";
	close2;

	npctalk "Place a la troupe !";

	enablenpc "Danseuse Nacoruri";
	enablenpc "Danseuse Dancer";

	sleep 500;

	unitwalk getnpcid(0,"TroupeLeader"),156,179;
	unitwalk getnpcid(0,"Danseuse Nacoruri"),156,177;
	unitwalk getnpcid(0,"Danseuse Dancer"),157,177;

	sleep 8000;
	sleep 3000;

	npctalk "Salsa", "TroupeLeader";
	npctalk "Salsa", "Danseuse Nacoruri";
	npctalk "Salsa", "Danseuse Dancer";

	end;
}

