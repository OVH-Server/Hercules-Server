// Gardien 1
gonryun,211,118,4	script	Gardien Sacré#1	4_M_CHNSOLDIER,{

	// Orientation vers la gauche
	setnpcdir getnpcid(0),3;

	mes "[Gardien Sacré]";
	mes "Personne ne passe sans le mot de passe.";
	next;

	input .@pass$;

	if (.@pass$ != "123") {
		mes "[Gardien Sacré]";
		mes "Mot de passe incorrect.";
		close;
	}

	mes "[Gardien Sacré]";
	mes "Très bien. Tu as 10 secondes.";
	close2;

	set #AccessOK,1;
	addtimer 10000, strnpcinfo(3)+"::OnReset";

	end;

OnReset:
	set #AccessOK,0;
	end;
}

