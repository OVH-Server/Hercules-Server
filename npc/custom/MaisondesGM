//======================
// Gardien 1
//======================
gonryun,211,118,3	script	Gardien Sacré#1	4_M_CHNSOLDIER,{

	mes "[Gardien Sacré]";
	mes "Personne ne passe sans le mot de passe.";
	next;

	input .@pass$;

	if (.@pass$ != "123") {
		mes "[Gardien Sacré]";
		mes "Mot de passe incorrect.";
		close;
	}

	mes "[Gardien Sacré]";
	mes "Très bien. Tu as 10 secondes pour entrer.";
	close2;

	set #GonryunAccessTime, gettimetick(2) + 10;
	end;
}

